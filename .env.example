BASE_URL=https://automationexercise.com/

# Optional - only used by `npm run test:a11y:ai` (the AI-assisted alt-text
# accessibility check). Without it, that test is skipped, not failed.
ANTHROPIC_API_KEY=
# Optional - overrides the model used for the check above.
# A11Y_AI_MODEL=claude-haiku-4-5-20251001

# Optional - only used locally (never in CI) by reporters/perfReporter.ts to
# persist per-test performance data. Matches docker-compose.yml's default
# credentials - `npm run perf:db:up` + this default just works.
PERF_DB_URL=postgres://perf:perf@localhost:5432/perf
